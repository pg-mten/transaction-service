// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["transaction"]
}

model TopUpTransaction {
  id                BigInt                   @id @default(autoincrement()) @db.BigInt
  code              String                @unique @default(uuid())
  merchantId        Int                   @db.Integer
  externalId        String?
  referenceId       String                @unique /// reff id from bank
  nominal           Decimal @db.Decimal(18,2)
  netNominal        Decimal @db.Decimal(18,2)
  status            TransactionStatusEnum @default(PENDING)
  providerName      String
  paymentMethodName String //transfer_bank, virtual_account
  receiptImage      String

  paidAt            DateTime?
  metadata          Json? 	@db.Json
  settlementAt      DateTime?
  reconciliationAt  DateTime?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  merchantBalanceLog MerchantBalanceLog[]
  agentBalanceLog    AgentBalanceLog[]
  internalBalanceLog InternalBalanceLog[]
  feeDetails         TopupFeeDetail[]

  @@index([referenceId])
  @@index([merchantId])
  @@schema("transaction")
}

model TopupFeeDetail {
  id            BigInt         @id @default(autoincrement()) @db.BigInt
  agentId       Int?  @db.Integer
  topupId       BigInt @db.BigInt
  type          FeeTypeEnum
  nominal       Decimal @db.Decimal(18,2)
  feeFixed      Decimal @db.Decimal(10,2)
  feePercentage Decimal @db.Decimal(10,2)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  topUpTransation TopUpTransaction @relation(fields: [topupId], references: [id], onDelete: Cascade)

  @@index([topupId])
  @@schema("transaction")
}

model WithdrawTransaction {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  code        String  @unique @default(uuid())
  externalId  String?
  userId      Int @db.Integer
  userRole    String
  referenceId String  @unique //reff id from bank

  providerName      String
  paymentMethodName String // transfer_bank, virtual_account, dll
  nominal    Decimal @db.Decimal(18,2)
  netNominal Decimal @db.Decimal(18,2) // nominal setelah dikenakan fee
  status     TransactionStatusEnum @default(PENDING)

  paidAt            DateTime?
  metadata          Json? 	@db.Json
  reconciliationAt DateTime?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails         WithdrawFeeDetail[]
  MerchantBalanceLog MerchantBalanceLog[]
  AgentBalanceLog    AgentBalanceLog[]
  InternalBalanceLog InternalBalanceLog[]

  @@index([userId])
  @@index([status])
  @@schema("transaction")
}

model WithdrawFeeDetail {
  id            BigInt         @id @default(autoincrement()) @db.BigInt
  agentId       Int? @db.Integer
  withdrawId    BigInt @db.BigInt
  type          FeeTypeEnum
  nominal       Decimal @db.Decimal(18,2)
  feeFixed      Decimal @db.Decimal(10,2)
  feePercentage Decimal @db.Decimal(10,2)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  withdrawTransaction WithdrawTransaction @relation(fields: [withdrawId], references: [id], onDelete: Cascade)

  @@index([withdrawId])
  @@schema("transaction")
}

model DisbursementTransaction {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  code        String  @unique @default(uuid())
  orderId     String  @unique
  externalId  String?
  referenceId String?
  merchantId  Int @db.Integer

  providerName      String
  recipientName     String // bisa merchant, agent, atau pihak ketiga
  recipientBankCode String
  recipientBankName String?
  recipientAccount  String
  nominal           Decimal @db.Decimal(18,2)
  netNominal        Decimal @db.Decimal(18,2)
  status            TransactionStatusEnum @default(PENDING)

  paidAt            DateTime?
  paymentMethodName String
  metadata          Json? 	@db.Json
  reconciliationAt  DateTime?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails         DisbursementFeeDetail[]
  MerchantBalanceLog MerchantBalanceLog[]
  AgentBalanceLog    AgentBalanceLog[]
  InternalBalanceLog InternalBalanceLog[]

  @@index([providerName])
  @@index([status])
  @@schema("transaction")
}

model DisbursementFeeDetail {
  id             BigInt         @id @default(autoincrement()) @db.BigInt
  agentId        Int? @db.Integer
  disbursementId BigInt @db.BigInt
  type           FeeTypeEnum
  nominal        Decimal @db.Decimal(18,2)
  feeFixed       Decimal @db.Decimal(10,2)
  feePercentage  Decimal @db.Decimal(10,2)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  disbursementTransaction DisbursementTransaction @relation(fields: [disbursementId], references: [id], onDelete: Cascade)

  @@index([disbursementId])
  @@schema("transaction")
}

model PurchaseTransaction {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  code        String  @unique
  orderId     String  @unique
  referenceId String?
  externalId  String
  merchantId  Int @db.Integer
  nmid        String?

  providerName      String
  paymentMethodName String
  nominal           Decimal @db.Decimal(18,2)
  netNominal        Decimal @db.Decimal(18,2)
  status            TransactionStatusEnum @default(PENDING)

  paidAt           DateTime?
  expiresAt        DateTime
  metadata         Json? 	@db.Json
  settlementAt     DateTime?
  reconciliationAt DateTime?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails         PurchaseFeeDetail[]
  webhookLogs        WebhookLog[]
  MerchantBalanceLog MerchantBalanceLog[]
  AgentBalanceLog    AgentBalanceLog[]
  InternalBalanceLog InternalBalanceLog[]

  @@index([merchantId])
  @@index([providerName])
  @@index([status])
  @@schema("transaction")
}

model PurchaseFeeDetail {
  id            BigInt         @id @default(autoincrement()) @db.BigInt
  agentId       Int? @db.Integer
  purchaseId    BigInt @db.BigInt
  type          FeeTypeEnum
  nominal       Decimal
  feeFixed      Decimal
  feePercentage Decimal

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  // Relasi
  transaction PurchaseTransaction @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@schema("transaction")
}

model WebhookLog {
  id              BigInt                 @id @default(autoincrement()) @db.BigInt
  transactionId   BigInt @db.BigInt
  source          String // e.g. midtrans, xendit
  payload         Json 	@db.Json
  rawSignature    String?
  receivedAt      DateTime            @default(now())
  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  PurchaseTransaction   PurchaseTransaction? @relation(fields: [purchaseTransactionId], references: [id])
  purchaseTransactionId Int?

  @@index([source])
  @@schema("transaction")
}

model TransactionAudit {
  id              BigInt                   @id @default(autoincrement()) @db.BigInt
  transactionId   BigInt @db.BigInt
  oldStatus       TransactionStatusEnum
  newStatus       TransactionStatusEnum
  source          String // "webhook", "admin", etc
  changedAt       DateTime              @default(now())
  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  @@index([transactionId])
  @@schema("transaction")
}

model MerchantBalanceLog {
  id              BigInt                 @id @default(autoincrement()) @db.BigInt
  topupId         BigInt? @db.BigInt
  purchaseId      BigInt? @db.BigInt
  withdrawId      BigInt? @db.BigInt
  disbursementId  BigInt? @db.BigInt
  merchantId      Int @db.Integer
  changeAmount    Decimal @db.Decimal(18,2) /// nominal perubahan (positif / negatif)
  balanceActive   Decimal @db.Decimal(18,2) /// saldo akhir merchant setelah perubahan
  balancePending  Decimal @db.Decimal(18,2)
  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  topupTransaction        TopUpTransaction?        @relation(fields: [topupId], references: [id], onDelete: SetNull)
  purchaseTransaction     PurchaseTransaction?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  withdrawTransaction     WithdrawTransaction?     @relation(fields: [withdrawId], references: [id], onDelete: SetNull)
  disbursementTransaction DisbursementTransaction? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([topupId])
  @@index([purchaseId])
  @@index([withdrawId])
  @@index([disbursementId])
  @@schema("transaction")
}

model AgentBalanceLog {
  id              BigInt                 @id @default(autoincrement()) @db.BigInt
  topupId         BigInt? @db.BigInt
  purchaseId      BigInt? @db.BigInt
  withdrawId      BigInt? @db.BigInt
  disbursementId  BigInt? @db.BigInt
  agentId         Int @db.Integer
  changeAmount    Decimal @db.Decimal(18,2) /// nominal perubahan (positif / negatif)
  balanceActive   Decimal @db.Decimal(18,2) /// saldo akhir merchant setelah perubahan
  balancePending  Decimal @db.Decimal(18,2)
  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  topupTransaction        TopUpTransaction?        @relation(fields: [topupId], references: [id], onDelete: SetNull)
  purchaseTransaction     PurchaseTransaction?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  withdrawTransaction     WithdrawTransaction?     @relation(fields: [withdrawId], references: [id], onDelete: SetNull)
  disbursementTransaction DisbursementTransaction? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([topupId])
  @@index([purchaseId])
  @@index([withdrawId])
  @@index([disbursementId])
  @@schema("transaction")
}

model InternalBalanceLog {
  id                BigInt                 @id @default(autoincrement()) @db.BigInt
  topupId           BigInt? @db.BigInt
  purchaseId        BigInt? @db.BigInt
  withdrawId        BigInt? @db.BigInt
  disbursementId    BigInt? @db.BigInt
  merchantId        Int? @db.Integer
  changeAmount    Decimal @db.Decimal(18,2) /// nominal perubahan (positif / negatif)
  balanceActive   Decimal @db.Decimal(18,2) /// saldo akhir merchant setelah perubahan
  balancePending  Decimal @db.Decimal(18,2)
  transactionType   TransactionTypeEnum
  providerName      String
  paymentMethodName String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy Int?      @db.Integer()

  topupTransaction        TopUpTransaction?        @relation(fields: [topupId], references: [id], onDelete: SetNull)
  purchaseTransaction     PurchaseTransaction?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  withdrawTransaction     WithdrawTransaction?     @relation(fields: [withdrawId], references: [id], onDelete: SetNull)
  disbursementTransaction DisbursementTransaction? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  @@index([topupId])
  @@index([purchaseId])
  @@index([withdrawId])
  @@index([disbursementId])
  @@schema("transaction")
}

enum TransactionStatusEnum {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED

  @@schema("transaction")
}

enum FeeTypeEnum {
  AGENT
  INTERNAL
  PROVIDER
  MERCHANT

  @@schema("transaction")
}

enum TransactionTypeEnum {
  WITHDRAW
  TOPUP
  DISBURSEMENT
  PURCHASE
  SETTLEMENT_PURCHASE

  @@schema("transaction")
}
